# ============================================
# CONFIGURACION MQTT
# ============================================
# El broker debe ser el mismo que usa el ESP32 (config.h)
# HiveMQ Cloud con TLS
MQTT_BROKER=tu-broker.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=tu_usuario
MQTT_PASS=tu_password
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=alarma_telegram_bridge
MQTT_USE_TLS=true

# ============================================
# CONFIGURACION TELEGRAM
# ============================================
# Token del bot (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID del administrador principal (opcional, se configura con /start)
TELEGRAM_ADMIN_CHAT_ID=

# Auto-corregir IDs de supergrupo guardados sin '-' (default true).
# La app Ionic a veces los guarda mal; este flag aplica un fix defensivo.
# Patron detectado: positivo de 13 digitos arrancando con "100".
TELEGRAM_AUTO_FIX_GROUP_ID=true

# ============================================
# CONFIGURACION DEL DISPOSITIVO
# ============================================
# Dejar vacio para auto-detectar del primer mensaje ESP32
# O especificar si conoces el device_id de tu ESP32
DEVICE_ID=

# ============================================
# FIREBASE (Opcional)
# ============================================
# Ruta al archivo de credenciales de Firebase
# Descargalo desde: Firebase Console > Configuracion > Cuentas de servicio
# Si no se configura, se usara almacenamiento local
FIREBASE_CREDENTIALS=firebase_credentials.json

# ============================================
# INTELIGENCIA ARTIFICIAL
# ============================================
# Habilitar/deshabilitar IA (true/false)
AI_ENABLED=true

# Backend LLM principal: "ollama" (local, default) o "groq" (remoto, fallback)
LLM_BACKEND=ollama

# --- Ollama (principal) ---
# Ollama corriendo en el VPS con GPU
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gtp-oss:20b

# --- Groq (fallback opcional) ---
# API Key de Groq (gratuita en console.groq.com)
# Solo se usa si LLM_BACKEND=groq o como fallback si Ollama falla
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- RAG (Respuestas con documentacion) ---
# Permite responder preguntas informativas sobre el sistema
RAG_ENABLED=true
# Numero maximo de fragmentos de documentacion a incluir como contexto
RAG_MAX_CHUNKS=3
# Score minimo de similitud TF-IDF para considerar un fragmento relevante
RAG_MIN_SCORE=0.15

# ============================================
# SOPORTE HUMANO (escalacion)
# ============================================
# Datos de contacto que el bot muestra al usuario cuando no puede
# resolver una consulta o detecta una queja. Si algun campo queda
# vacio, no se incluye en el mensaje.
SUPPORT_EMAIL=helper@sentinelguard.com
SUPPORT_PHONE=
SUPPORT_HOURS=Lunes a Viernes de 9:00 AM a 6:00 PM
# URLs usadas en modo vendedor (usuarios no registrados que preguntan al bot).
# Si quedan vacios, el bot no los menciona.
SUPPORT_APP_STORE_URL=https://apps.apple.com/es/app/sentinel-guard/id6744034961
SUPPORT_LANDING_URL=

# ============================================
# BOT DE ADMINISTRACION (Admin Monitor)
# ============================================
# Token del bot de admin separado (obtenido de @BotFather)
# Este bot permite: ver logs, git pull, restart, pause/resume
ADMIN_BOT_TOKEN=

# ============================================
# DEBUG Y LOGS
# ============================================
DEBUG=true
LOG_FILE=alarm_service.log

# ---------------------------------------------------------------------------
# Endpoint HTTP de Senti (la app pregunta sin pasar por Telegram)
# ---------------------------------------------------------------------------
API_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8765

# Como se identifica quien pregunta:
#   firebase  el ID token de la app. Lo correcto en produccion.
#   clave     una clave compartida (API_CLAVE). Para demos: sin sesion, pero
#             tampoco abierto al primero que encuentre la URL de ngrok.
#   abierto   sin autenticacion. SOLO en local, NUNCA detras de ngrok: cada
#             pregunta gasta LLM y la factura es tuya.
API_AUTH=firebase
API_CLAVE=

# Tope por usuario. Dos limites y hacen falta los dos: el de la hora frena el
# gasto sostenido, el de los segundos frena la rafaga.
API_MAX_POR_HORA=20
API_ESPERA_MIN_SEG=3

# API local del agente de ngrok, para publicar la URL publica en RTDB.
# Vacio = no se publica.
NGROK_API=http://127.0.0.1:4040/api/tunnels
API_RUTA_URL=Config/ai_endpoint
