# ============================================
# CONFIGURACION MQTT
# ============================================
# El broker debe ser el mismo que usa el ESP32 (config.h)
# HiveMQ Cloud con TLS
MQTT_BROKER=tu-broker.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=tu_usuario
MQTT_PASS=tu_password
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=alarma_telegram_bridge
MQTT_USE_TLS=true

# ============================================
# CONFIGURACION TELEGRAM
# ============================================
# Token del bot (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID del administrador principal (opcional, se configura con /start)
TELEGRAM_ADMIN_CHAT_ID=

# ============================================
# CONFIGURACION DEL DISPOSITIVO
# ============================================
# Dejar vacio para auto-detectar del primer mensaje ESP32
# O especificar si conoces el device_id de tu ESP32
DEVICE_ID=

# ============================================
# FIREBASE (Opcional)
# ============================================
# Ruta al archivo de credenciales de Firebase
# Descargalo desde: Firebase Console > Configuracion > Cuentas de servicio
# Si no se configura, se usara almacenamiento local
FIREBASE_CREDENTIALS=firebase_credentials.json

# ============================================
# INTELIGENCIA ARTIFICIAL
# ============================================
# Habilitar/deshabilitar IA (true/false)
AI_ENABLED=true

# Backend LLM principal: "ollama" (local, default) o "groq" (remoto, fallback)
LLM_BACKEND=ollama

# --- Ollama (principal) ---
# Ollama corriendo en el VPS con GPU
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gtp-oss:20b

# --- Groq (fallback opcional) ---
# API Key de Groq (gratuita en console.groq.com)
# Solo se usa si LLM_BACKEND=groq o como fallback si Ollama falla
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- RAG (Respuestas con documentacion) ---
# Permite responder preguntas informativas sobre el sistema
RAG_ENABLED=true
# Numero maximo de fragmentos de documentacion a incluir como contexto
RAG_MAX_CHUNKS=3
# Score minimo de similitud TF-IDF para considerar un fragmento relevante
RAG_MIN_SCORE=0.15

# ============================================
# BOT DE ADMINISTRACION (Admin Monitor)
# ============================================
# Token del bot de admin separado (obtenido de @BotFather)
# Este bot permite: ver logs, git pull, restart, pause/resume
ADMIN_BOT_TOKEN=

# ============================================
# DEBUG Y LOGS
# ============================================
DEBUG=true
LOG_FILE=alarm_service.log
